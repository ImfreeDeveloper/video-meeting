{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formatting with Prettier",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; [ -n \"$f\" ] || exit 0; cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null; pnpm exec prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
