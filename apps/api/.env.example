# Port the Nest HTTP server listens on.
PORT=3001

# Postgres connection string for Prisma — matches the defaults in the
# root docker-compose.yml / .env.example. Adjust user/password/db/port to match.
DATABASE_URL="postgresql://claudelar:claudelar@localhost:5432/claudelar?schema=public"

# Secret used to sign/verify JWT access tokens, and their lifetime.
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="1h"

# Origin allowed to call the API via CORS — the @claudelar/web dev server by default.
CORS_ORIGIN="http://localhost:3000"

# Directory meeting file uploads are stored in (relative to apps/api, or absolute).
FILE_STORAGE_DIR="./storage/uploads"

# Maximum size (bytes) of a single meeting file upload. Default: 500 MiB.
MAX_FILE_SIZE_BYTES=524288000
